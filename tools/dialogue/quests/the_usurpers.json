      }
    },
    {
      "id": "imoinu",
      "name": { "en": "Imoinu Kato", "zh": "Imoinu Kato" },
      "title": {
        "en": "'Treasonous' double-agent, based on Umbra",
        "zh": "'叛国'双面特工，位于 Umbra"
      }
    },
    {
      "id": "perseus",
      "name": { "en": "Perseus", "zh": "Perseus" },
      "title": {
        "en": "Macario's agent at the Fringe Jump-point of Askonia",
        "zh": "Macario 的特工，现身于 Askonia 边缘跳点"
      }
    }
  ],
