{
  "id": "the_usurpers",
  "gameId": "sdtu",
  "name": { "en": "The Usurpers", "zh": "篡夺者" },
  "factionId": "sindrian_diktat",
  "summary": {
    "en": "A mysterious 'concerned citizen' named Yannick Ram contacts you with a plan to save the Sindrian Diktat from itself — and introduces you to Chief High Inspector Dolos Macario, the 'Spider of Sindria', who has designs on the throne of Supreme Executor Philip Andrada.",
    "zh": "一位神秘的'忧国之士' Yannick Ram 联系上了你，声称有一个'把辛达强权从它自己手里拯救出来'的计划 —— 并把你引荐给了辛德里亚之蛛、首席督察长 Dolos Macario，一个对最高元首 Philip Andrada 的宝座有所图谋的人。"
  },
  "icon": "graphics/icons/missions/the_usurpers.png",
  "stages": [
    {
      "id": "MEET_RAM",
      "flag": "$sdtu_meetRamOnVolturn",
      "briefing": {
        "en": "Meet Yannick Ram at his safehouse on Volturn. He has a plan to save the Sindrian Diktat from itself.",
        "zh": "在 Volturn 的安全屋会见 Yannick Ram。他有一个让辛达强权免于自我毁灭的计划。"
      }
    },
    {
      "id": "INTERCEPT_FLEET",
      "flag": "$sdtu_interceptFleet",
      "briefing": {
        "en": "Find and intercept a Sindrian Diktat patrol fleet led by the 'treasonous' officer. It can be found in the Askonia system.",
        "zh": "找到并拦截由\"叛国\"军官领导的辛达强权巡逻舰队。它就在 Askonia 星系中。"
      }
    },
    {
      "id": "MEET_HYDER",
      "flag": "$sdtu_meetHyder",
      "briefing": {
        "en": "Use the 'treasonous' officer as leverage to gain access to Deputy Star Marshal Hyder. She can be found in command of the Askonia System Defense Armada, a large warfleet patrolling the Askonia star system.",
        "zh": "利用\"叛国\"军官作为突破口，接近副星际元帅 Hyder。她指挥着 Askonia 星系防御无敌舰队，这是一支在 Askonia 星系内巡逻的大型舰队。"
      }
    },
    {
      "id": "RETURN_TO_MACARIO",
      "flag": "$sdtu_didHyderMeeting",
      "briefing": {
        "en": "Report back to Macario about your conversation with Hyder.",
        "zh": "把你跟 Hyder 的谈话汇报给 Macario。"
      }
    },
    {
      "id": "EXTRACT_AGENT",
      "flag": "$sdtu_extractAgent",
      "briefing": {
        "en": "Extract a known double-agent who, while working for Horacio Caden, has betrayed the Sindrian Diktat. The 'treasonous' double-agent is based on Umbra.",
        "zh": "解救一名为 Horacio Caden 效力、同时背叛了辛达强权的双面特工。这位\"叛国\"的双面特工位于 Umbra。"
      }
    },
    {
      "id": "MEET_CADEN",
      "flag": "$sdtu_meetCaden",
      "briefing": {
        "en": "Speak with Guard High Deputy Executor Caden. He can be found in command of the Lion's Guard Grand Armada, a large warfleet patrolling the Askonia star system.",
        "zh": "利用\"叛国\"特工作为突破口，接近卫队最高副首长 Caden。他指挥着狮心卫队大无敌舰队，这是一支在 Askonia 星系内巡逻的大型舰队。"
      }
    },
    {
      "id": "AGAIN_WTH_MACARIO",
      "flag": "$sdtu_didCadenMeeting",
      "briefing": {
        "en": "Report back to Macario about your conversation with Caden.",
        "zh": "把你跟 Caden 的谈话汇报给 Macario。"
      }
    },
    {
      "id": "EMERGENCY_INTERCEPT",
      "flag": "$sdtu_emergencyIntercept",
      "briefing": {
        "en": "Intercept and assist or capture Macario's agent at the Fringe Jump-point of Askonia.",
        "zh": "前往 Askonia 的边缘跳跃点拦截并抓捕或协助 Macario 的特工。"
      }
    },
    {
      "id": "DELIVER_NEWS",
      "flag": "$sdtu_deliverNews",
      "briefing": {
        "en": "Report back to Macario with news of his agent's demise.",
        "zh": "向 Macario 汇报他的特工已经身亡。"
      }
    },
    {
      "id": "COMPLETED",
      "flag": "$sdtu_missionCompleted",
      "briefing": { "en": "Mission complete.", "zh": "任务完成。" }
    }
  ],
  "characters": [
