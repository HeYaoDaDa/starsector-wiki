{
  "id": "the_seven_sons",
  "gameId": "sd7s",
  "name": {
    "en": "The Seven Sons",
    "zh": "七子"
  },
  "summary": {
    "en": "With Macario's files in hand, find a way to decrypt the ANDRADA dossier, then hunt down the seven clone-sons of Supreme Executor Philip Andrada - each a potential heir to the Sindrian Diktat.",
    "zh": "带着 Macario 的文件，设法解密 ANDRADA 档案，再找出最高元首 Philip Andrada 的七名克隆子嗣——每一个都是辛达强权王座的潜在继承人。"
  },
  "factionId": "sindrian_diktat",
  "stages": [
    {
      "id": "CRACK_FILES",
      "flag": "$sd7s_decryptedAndradaFiles",
      "briefing": {
        "en": "Find a way to decrypt the ANDRADA files.",
        "zh": "设法解密 ANDRADA 文件。"
      }
    },
    {
      "id": "TALK_GARGOYLE",
      "flag": "$sd7s_decryptViaGargoyle",
      "briefing": {
        "en": "Take the files to Gargoyle and convince the hacker to decrypt them.",
        "zh": "把文件带给 Gargoyle，说服这名黑客将其解密。"
      }
    },
    {
      "id": "TALK_ORCUS",
      "flag": "$sd7s_decryptViaOrcusRao",
      "briefing": {
        "en": "Take the files to Orcus Rao.",
        "zh": "将文件交给 Orcus Rao。"
      }
    },
    {
      "id": "TALK_ARROYO",
      "flag": "$sd7s_decryptViaArroyo",
      "briefing": {
        "en": "Take the files to Rayan Arroyo. He'll know how to turn this situation toward his advantage.",
        "zh": "将文件交给 Rayan Arroyo。他自然知道如何把这场乱局变成自己的进项。"
      }
    },
    {
      "id": "TALK_INESIS",
      "flag": "$sd7s_decryptViaInesis",
      "briefing": {
        "en": "Take the files to Faro Inesis to see if you can use Tri-Tachyon black-site resources to decrypt them.",
        "zh": "将文件交给 Faro Inesis，看能否借助速子科技的黑色站点资源将其解密。"
      }
    },
    {
      "id": "TALK_SIYAVONG",
      "flag": "$sd7s_decryptViaSiyavong",
      "briefing": {
        "en": "Take the files to Special Agent Finlay Siyavong of Fleet Intelligence to see if he can help.",
        "zh": "将这些文件交给舰队情报部的特工 Finlay Siyavong，看看他是否愿意帮你解密。"
      }
    },
    {
      "id": "TALK_HORUS_YARIBAY",
      "flag": "$sd7s_stage",
      "briefing": {
        "en": "Take the files to Horus Yaribay, on Kazeron.",
        "zh": "将文件交给 Kazeron 上的 Horus Yaribay。"
      }
    },
    {
      "id": "TALK_REYNARD_HANNAN",
      "flag": "$sd7s_stage",
      "briefing": {
        "en": "Take the files to Reynard Hannan, on Kazeron.",
        "zh": "将文件交给 Kazeron 上的 Reynard Hannan。"
      }
    },
    {
      "id": "TALK_TO_AI",
      "flag": "$sd7s_decryptViaOwnAI",
      "briefing": {
        "en": "You've decided to use your alpha-core AI administrator's abilities to decrypt the files.",
        "zh": "你决定动用你的 Alpha 核心 AI 管理员的能力来解密这些文件。"
      }
    },
    {
      "id": "FIND_THEM",
      "flag": "$sd7s_findAchilles",
      "briefing": {
        "en": "Find the seven clone-sons of Philip Andrada.",
        "zh": "找到 Philip Andrada 的七名克隆子嗣。"
      }
    },
    {
      "id": "COMPLETED",
      "flag": "$sd7s_missionCompleted",
      "briefing": {
        "en": "Mission complete.",
        "zh": "任务完成。"
      }
    }
  ],
