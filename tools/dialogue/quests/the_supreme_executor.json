{
  "id": "the_supreme_executor",
  "gameId": "sdse",
  "name": {
    "en": "The Supreme Executor",
    "zh": "最高元首"
  },
  "summary": {
    "en": "Hector and Achilles Andrada - and their backers - maneuver to declare themselves Supreme Executor of the Sindrian Diktat. Choose a side, or play them all.",
    "zh": "Hector 与 Achilles Andrada——以及他们背后的支持者——正为登上辛达强权的最高元首之位各显神通。选边站，或者，把每一方都玩弄于股掌之间。"
  },
  "factionId": "sindrian_diktat",
  "stages": [
    {
      "id": "MACARIOS_PLOT",
      "flag": "$sdse_inProgress",
      "briefing": {
        "en": "Dolos Macario has made the first move. You must choose how to respond.",
        "zh": "Dolos Macario 已经先出手了。你必须决定如何应对。"
      }
    },
    {
      "id": "TALK_TO_CONTACT",
      "flag": "$sdse_talkToContact",
      "briefing": {
        "en": "Talk to your contact.",
        "zh": "与你的联系人谈谈。"
      }
    },
    {
      "id": "TALK_TO_ACHILLES",
      "flag": "$sdse_talkToAchilles",
      "briefing": {
        "en": "Contact Achilles Andrada and tell him you will give him your support.",
        "zh": "联系 Achilles Andrada，告知你将支持他。"
      }
    },
    {
      "id": "VISIT_RELAY",
      "flag": "$sdse_visitRelay",
      "briefing": {
        "en": "Go to the comms relay in the Askonia system.",
        "zh": "前往 Askonia 星系的通讯中继站。"
      }
    },
    {
      "id": "WAIT_FOR_OPENING",
      "flag": "$sdse_waitForOpening",
      "briefing": {
        "en": "Wait for one of the major players to make a move.",
        "zh": "等待某位主要角逐者先出手。"
      }
    },
    {
      "id": "HECTOR_REVEALED",
      "flag": "$sdse_hectorDeclaredStageAdvance",
      "briefing": {
        "en": "Hector has declared himself Supreme Executor with the support of Macario and Caden.",
        "zh": "在 Macario 与 Caden 的支持下，Hector 已自立为最高元首。"
      }
    },
    {
      "id": "HECTOR_REVEALED2",
      "flag": "$sdse_hectorDeclaredStageAdvance2",
      "briefing": {
        "en": "Achilles is sure to make his own declaration soon...",
        "zh": "Achilles 想必很快也会站出来宣布自己的主张..."
      }
    },
    {
      "id": "ACHILLES_REVEALED",
      "flag": "$sdse_achillesDeclaredStageAdvance",
      "briefing": {
        "en": "Achilles 'Kalian' Andrada, backed by Fortuna Kato, declares himself Supreme Executor.",
        "zh": "有 Fortuna Kato 撑腰的 Achilles 'Kalian' Andrada 宣布自己为最高元首。"
      }
    },
    {
      "id": "COMPLETED",
      "flag": "$sdse_missionCompleted",
      "briefing": {
        "en": "Mission complete.",
        "zh": "任务完成。"
      }
    }
  ],
