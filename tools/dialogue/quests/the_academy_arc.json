  "icon": "graphics/icons/missions/ga_intro.png",
  "stages": [
    {
      "id": "gaIntro",
      "flag": "$gaIntro_ref",
      "briefing": {
        "en": "",
        "zh": "前往 Galatia 学院，并与新任院长 "
      }
    },
    {
      "id": "gaIntro2",
      "flag": "$gaIntro2_ref",
      "briefing": {
        "en": "Return the data core to Academician Sebestyen. He'll get you your reward.",
        "zh": "将数据核心交还给 Sebestyen 院士，并领取你的报酬。"
      }
    },
    {
      "id": "gaData",
      "flag": "$gaData_ref",
      "briefing": {
        "en": "marines will be needed to perform the recovery.",
        "zh": "，并从废墟中找到 "
      }
    },
    {
      "id": "gaDA",
      "flag": "$gaDA_ref",
      "briefing": {
        "en": " 'Autonomous weapon systems' may pose a danger.",
        "zh": "一个独特的超导结构元件"
      }
    },
    {
      "id": "gaCO",
      "flag": "$gaCO_ref",
      "briefing": {
        "en": " Avoid the black hole located in-system.",
        "zh": " 避开位于星系中的黑洞。"
      }
    },
    {
      "id": "gaProbe",
      "flag": "$gaProbe_ref",
      "briefing": {
        "en": "Go to the nearest jump-point and retrieve the instrument package from scavengers before they leave the system.",
        "zh": "从探测器中打捞仪器套件，目标 "
      }
    },
    {
      "id": "gaVIP",
      "flag": "$gaVIP_ref",
      "briefing": {
        "en": " is kin to Kanta herself.",
        "zh": "步入 '卢德之路'"
      }
    },
    {
      "id": "gaOp",
      "flag": "$gaOp_ref",
      "briefing": {
        "en": ", and drop off a small team of scientists at an outpost located there.",
        "zh": "，并将一小队科学家送到 位于那里的 一个前哨站中。"
      }
    },
    {
      "id": "gaBA",
      "flag": "$gaBA_ref",
      "briefing": {
        "en": "",
        "zh": "一个独特的可再生结构元件"
      }
    },
    {
      "id": "gaRR",
      "flag": "$gaRR_ref",
      "briefing": {
        "en": "",
        "zh": "Galatia 学院"
      }
    },
    {
      "id": "gaTJ",
      "flag": "$gaTJ_ref",
      "briefing": {
        "en": ", and contact the 'researcher' at the Tri-Tachyon black research site located there.",
        "zh": "，与位于速子 黑色研究基地 中的 '研究员' 联系。"
      }
    },
    {
      "id": "gaTTS",
      "flag": "$gaTTS_ref",
      "briefing": {
        "en": "",
        "zh": "联系 Galatia 学院的院士 "
      }
    },
    {
      "id": "gaTTB",
      "flag": "$gaTTB_ref",
      "briefing": {
        "en": "",
        "zh": "联系 Galatia 学院的院长 "
      }
    },
    {
      "id": "gaFC",
      "flag": "$gaFC_ref",
      "briefing": {
        "en": "You've found Academician Scylla Coureuse and brought her out of hiding to return her to work on Baird's secret project at the Galatia Academy.",
        "zh": "寻找 Coureuse"
      }
    },
    {
      "id": "gaPZ",
      "flag": "$gaPZ_ref",
      "briefing": {
        "en": "Get a lead on the whereabouts of Kelise Astraia, who is associated with a secret Tri-Tachyon research base called \"Alpha Site\".",
        "zh": "找到 Kelise Astraia 的下落，此人和被称为 \"阿尔法研究站\" 的 速子科技 秘密研究基地有关系。"
      }
    },
    {
      "id": "gaRH",
      "flag": "$gaRH_ref",
      "briefing": {
        "en": "She is sentimental about the ship - her first independent command - and is willing to pay a large sum for its return.",
        "zh": "将 ISS Hamatsu 号还给 "
      }
    },
    {
      "id": "gaKA",
      "flag": "$gaKA_ref",
      "briefing": {
        "en": "You've recovered the data archive of the Academy's previous Provost, Tomas Kallichore, which contains the results of failed gate activation experiments.",
        "zh": "Kallichore 的档案"
      }
    },
    {
      "id": "gaATG",
      "flag": "$gaATG_ref",
      "briefing": {
        "en": "Contact Horus Yaribay to get envoy credentials so you can contact High Hegemon Daud.",
        "zh": "联系 Horus Yaribay，来获得特使凭证，这样你就可以联系至高霸主 Daud 了。"
      }
    },
    {
      "id": "gaDHO",
      "flag": "$gaDHO_ref",
      "briefing": {
        "en": "Go directly to the coordinates held in the array's data.",
        "zh": "直接前往阵列数据中记录的坐标。"
      }
    }
  ],
