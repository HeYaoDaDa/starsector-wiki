{
  "id": "bornanew_files",
  "gameId": [
    "bffi"
  ],
  "factionId": null,
  "icon": "graphics/icons/missions/false_idols.png",
  "stages": [
    {
      "id": "I",
      "flag": "$bffi_I",
      "briefing": {
        "en": "Pick up Jethro Bornanew from Gilead.",
        "zh": "从 Gilead 接走 Jethro Bornanew。"
      }
    },
    {
      "id": "BORNANEW",
      "flag": "$bffi_BORNANEW",
      "briefing": {
        "en": "Go to Olinadu and contact Menes Yaribay, the planetary administrator.",
        "zh": "前往 Olinadu 并与行星管理员 Menes Yaribay 取得联系。"
      }
    },
    {
      "id": "JASPIS",
      "flag": "$bffi_JASPIS",
      "briefing": {
        "en": "Go to Kazeron and talk to Horus Yaribay about his cousin Menes.",
        "zh": "前往 Kazeron 与 Horus Yaribay 商讨关于他表亲 Menes 的事宜。"
      }
    },
    {
      "id": "ULMUS_POND",
      "flag": "$bffi_ULMUS_POND",
      "briefing": {
        "en": "Attend Menes Yaribay's 'gathering' on Olinadu and find a way to steal the false relic.",
        "zh": "前往 Olinadu 参加 Menes Yaribay 的 '聚会' 并设法窃取那件伪造遗物。"
      }
    },
    {
      "id": "MENES_YARIBAY",
      "flag": "$bffi_MENES_YARIBAY",
      "briefing": {
        "en": "Attend Menes Yaribay's 'gathering' on Olinadu with Horus Yaribay, the patriarch of Gens Yaribay.",
        "zh": "与 Yaribay 氏族的族长 Horus Yaribay 一同前往 Olinadu 参加 Menes Yaribay 的 '聚会'。"
      }
    },
    {
      "id": "HORUS_YARIBAY",
      "flag": "$bffi_HORUS_YARIBAY",
      "briefing": {
        "en": "Attend Menes Yaribay's 'gathering' on Olinadu and acquire the false relic.",
        "zh": "前往 Olinadu 参加 Menes Yaribay 的 '聚会' 并获取那件伪造遗物。"
      }
    },
    {
      "id": "CEDRA_KEEPFAITH",
      "flag": "$bffi_CEDRA_KEEPFAITH",
      "briefing": {
        "en": "Bring the false relic to Asher so that a nanoforge engineer in the employ of the Church can examine it.",
        "zh": "将伪造遗物带去 Asher，以便让一位受雇于教会的纳米锻炉工程师对其进行检查。"
      }
    },
    {
      "id": "ANY",
      "flag": "$bffi_ANY",
      "briefing": {
        "en": "Go to Olinadu and confront Ulmus Pond to get a confession.",
        "zh": "前往 Olinadu 与 Ulmus Pond 对质，以获取其供词。"
      }
    },
    {
      "id": "NOT_ANY",
      "flag": "$bffi_NOT_ANY",
      "briefing": {
        "en": "Go to Chalcedon and use Bornanew's intel to track down where Ulmus Pond is hiding.",
        "zh": "前往 Chalcedon，利用 Bornanew 提供的情报追踪 Ulmus Pond 的藏身之处。"
      }
    },
    {
      "id": "PICK_UP_BORNANEW",
      "flag": "$bffi_PICK_UP_BORNANEW",
      "briefing": {
        "en": " and investigate. Find where the glove came from and how it was made. Ensure no more will be created.",
        "zh": " 并进行调查。查明那只手套的来源与制造方式。确保不会有更多此类物品被制造出来。"
      }
    },
    {
      "id": "MEET_MENES_YARIBAY",
      "flag": "$bffi_MEET_MENES_YARIBAY",
      "briefing": {
        "en": "Go to the Cathedral of Holy Exodus, on Tartessus, and arrest Subcurate Cedra Keepfaith.",
        "zh": "前往位于 Tartessus 的 Exodus 神圣大教堂，并逮捕助理祭司 Cedra Keepfaith。"
      }
    },
    {
      "id": "ATTEND_A_PARTY",
      "flag": "$bffi_ATTEND_A_PARTY",
      "briefing": {
        "en": "Deliver Cedra Keepfaith to the Knights of Ludd on Hesperus to face their justice.",
        "zh": "将 Cedra Keepfaith 交给 Hesperus 的卢德骑士团，让她接受他们的审判。"
      }
    }
  ],
